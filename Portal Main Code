<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AlumniConnect Portal</title>
<style>
:root{--navy:#173d53;--blue:#4b8ea1;--green:#4d9076;--ink:#283e4a;--muted:#71818b;--line:#e1eaec;--bg:#fbfcfc}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.bar{background:#fff;border-bottom:1px solid var(--line);min-height:74px;padding:0 max(5%,calc((100% - 1160px)/2));display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{border:0;background:none;color:var(--navy);font-size:19px;font-weight:800;display:flex;align-items:center;gap:9px}.mark{background:var(--navy);color:white;border-radius:10px;width:35px;height:35px;display:grid;place-items:center;font-size:11px}.brand em{font-style:normal;font-weight:400;color:#74929e}.nav{height:74px;display:flex;gap:20px}.nav button{border:0;border-bottom:3px solid transparent;background:none;color:#687982;font-size:13px;font-weight:bold}.nav button.active{border-bottom-color:var(--blue);color:var(--navy)}.btn{padding:10px 15px;border:1px solid transparent;border-radius:7px;font-size:13px;font-weight:bold}.primary{background:var(--navy);color:#fff}.secondary{background:#fff;color:var(--navy);border-color:#cad9de}.small{padding:8px 11px;font-size:12px}.wrap{max-width:1160px;margin:auto;padding:55px 0}.hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:410px;align-items:center;gap:30px}.eyebrow{color:#4a8999;letter-spacing:1.6px;font-size:10px;font-weight:bold}.hero h1,.title h1,h2,h3{color:var(--navy);letter-spacing:-1px;line-height:1.15}.hero h1{font-size:57px;margin:16px 0}.hero h1 span{color:var(--blue)}.lead,.title p,.card p{color:var(--muted)}.lead{max-width:510px;line-height:1.8}.row{display:flex;gap:10px;flex-wrap:wrap}.art{height:330px;display:grid;place-items:center;position:relative}.orbit{position:absolute;width:350px;height:255px;border:1px solid #dce8e8;border-radius:50%;transform:rotate(-25deg)}.spotlight{z-index:1;width:270px;background:white;border:1px solid var(--line);border-radius:15px;text-align:center;padding:22px;box-shadow:0 20px 50px #17384c17}.avatar{width:74px;height:74px;margin:15px auto;border-radius:50%;background:#dcece8;color:#35666b;display:grid;place-items:center;font-size:22px;font-weight:bold}.tag,.pill{display:inline-block;background:#edf5f3;color:#507a74;padding:5px 8px;border-radius:4px;font-size:10px;font-weight:bold}.note{position:absolute;background:white;border:1px solid var(--line);border-radius:9px;padding:10px 13px;box-shadow:0 10px 25px #183b5620;font-size:11px}.note.a{top:40px;right:0}.note.b{bottom:35px;left:0}.stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);padding:23px}.stat{text-align:center;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat b{display:block;color:var(--navy);font-size:25px}.stat span{font-size:11px;color:var(--muted)}.section{padding-top:63px}.head{display:flex;align-items:end;justify-content:space-between;margin-bottom:23px}.head h2{font-size:30px;margin:9px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:white;border:1px solid var(--line);border-radius:11px;padding:20px}.feature{min-height:200px}.feature:nth-child(1){background:#edf5f7}.feature:nth-child(2){background:#fbf6e7}.feature:nth-child(3){background:#edf6f0}.feature h3{margin:12px 0 7px}.link{color:#397d91;border:0;background:none;font-weight:bold;padding:0}.title{margin-bottom:22px}.title h1{font-size:42px;margin:9px 0}.search{max-width:680px;border:1px solid #dce7ea;border-radius:8px;background:#fff;padding:0 13px;display:flex;align-items:center;margin:20px 0}.search input{padding:13px;border:0;outline:0;flex:1;background:transparent}.person-head,.job-head{display:flex;justify-content:space-between;align-items:start;gap:10px}.mini{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:#e2eef0;color:#376d7d;font-weight:bold}.verified{font-size:10px;background:#e9f6ee;color:#438264;padding:5px 7px;border-radius:20px}.skills{display:flex;gap:5px;flex-wrap:wrap;margin-top:13px}.skills span{font-size:10px;background:#f0f5f6;color:#5e7c85;padding:5px 7px;border-radius:4px}.jobs{display:grid;gap:12px}.job{display:flex;gap:15px}.logo{width:45px;height:45px;flex:0 0 45px;display:grid;place-items:center;background:#e6f0f3;color:#397c8e;font-weight:bold;border-radius:10px}.event-date{font-size:11px;color:#45866e;font-weight:bold}.notice{padding:12px 15px;border-radius:7px;background:#eaf6ef;color:#2d7354;margin-bottom:20px;font-size:13px}.hide{display:none}.form{max-width:440px;margin:auto}.form label{display:grid;gap:6px;margin:13px 0;color:#536874;font-size:12px;font-weight:bold}.form input,.form select,.form textarea{border:1px solid #dce5e8;border-radius:6px;padding:10px}.dashboard{display:grid;grid-template-columns:1.6fr .8fr;gap:20px}.footer{border-top:1px solid var(--line);padding:24px;text-align:center;font-size:11px;color:#849199}@media(max-width:800px){.bar{padding:12px 5%;flex-wrap:wrap}.nav{order:3;width:100%;height:34px;overflow:auto}.wrap{padding:40px 5%}.hero{grid-template-columns:1fr}.hero h1{font-size:44px}.art{height:285px}.grid,.dashboard{grid-template-columns:1fr}.note.a{right:0}.note.b{left:0}.stats{padding:18px 0}.stat b{font-size:20px}}
</style></head><body>
<header class="bar"><button class="brand" onclick="go('home')"><span class="mark">AC</span>Alumni<em>Connect</em></button><nav class="nav" id="nav"></nav><span id="account"></span></header><main class="wrap"><div class="notice hide" id="notice"></div><div id="app"></div></main><footer class="footer">© 2026 AlumniConnect · Your community, connected.</footer>
<script>
const alumni=[['Jordan Davis','Product Designer','Northstar','Design','2020','Bengaluru','UX Research, Figma, Mentorship'],['Maya Patel','Data Analyst','Vertex Labs','Computer Science','2021','Mumbai','SQL, Python, Tableau'],['Rahul Mehta','Software Engineer','Cloudline','Engineering','2019','Pune','React, Node.js, AWS']];
const jobs=[['Frontend Developer Intern','Northstar','Internship','Remote','Work with a collaborative product team to build thoughtful web experiences.'],['Data Analyst','Vertex Labs','Full-time','Mumbai','Turn data into practical insights for a growing technology team.'],['Graduate Software Engineer','Cloudline','Full-time','Bengaluru','Build reliable cloud services with a supportive engineering community.']];
const events=[['NOV 12 · 6:30 PM','Alumni Networking Evening','Community Hall, Bengaluru','Reconnect with classmates and meet alumni across industries.'],['DEC 03 · 5:00 PM','Career Stories: Building in Tech','Online','An honest conversation with alumni working in technology.'],['JAN 18 · 10:00 AM','Mentorship Meet-up','Innovation Centre','Find a mentor, share your experience, and grow together.']];
let page='home',q='',user=JSON.parse(localStorage.getItem('alumni_connect_user')||'null');const $=s=>document.querySelector(s),initials=n=>n.split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase();
function flash(t){let n=$('#notice');n.textContent=t;n.classList.remove('hide');setTimeout(()=>n.classList.add('hide'),3200)}function go(p){page=p;render()}function nav(){let a=[['home','Overview'],['directory','Directory'],['jobs','Careers'],['events','Events']];if(user)a.push(['dashboard','Dashboard']);return a.map(x=>`<button class="${page===x[0]?'active':''}" onclick="go('${x[0]}')">${x[1]}</button>`).join('')}function header(){$('#nav').innerHTML=nav();$('#account').innerHTML=user?`<span style="font-size:12px;color:#64747d;margin-right:10px">Hi, ${user.name.split(' ')[0]}</span><button class="btn secondary small" onclick="logout()">Log out</button>`:`<button class="btn primary small" onclick="go('auth')">Sign in</button>`}
function home(){return `<section class="hero"><div><span class="eyebrow">● YOUR COMMUNITY, CONNECTED</span><h1>Great connections.<br><span>Lasting impact.</span></h1><p class="lead">Reconnect with classmates, discover career opportunities, and stay part of the community that helped shape your future.</p><div class="row"><button class="btn primary" onclick="go('directory')">Explore alumni ↗</button><button class="btn secondary" onclick="go('auth')">Join the community</button></div></div><div class="art"><div class="orbit"></div><div class="spotlight"><span class="eyebrow">ALUMNI SPOTLIGHT</span><div class="avatar">JD</div><h3>Jordan Davis</h3><p>Product Designer · Class of 2020</p><span class="tag">Design & Mentorship</span></div><div class="note a">✦ <b>New opportunity</b><br>Product Design Intern</div><div class="note b">✓ <b>Stay in the loop</b><br>Community updates</div></div></section><section class="stats"><div class="stat"><b>3+</b><span>Verified alumni</span></div><div class="stat"><b>3+</b><span>Open opportunities</span></div><div class="stat"><b>3+</b><span>Upcoming events</span></div></section><section class="section"><div class="head"><div><span class="eyebrow">FIND YOUR NEXT STEP</span><h2>A network that moves you forward.</h2></div></div><div class="grid"><article class="card feature"><b>◎</b><h3>People who get you</h3><p>Find alumni by graduation year, skills, or company and grow your professional circle.</p><button class="link" onclick="go('directory')">Explore directory →</button></article><article class="card feature"><b>↗</b><h3>Your next opportunity</h3><p>Discover jobs and internships shared by a community that wants to see you succeed.</p><button class="link" onclick="go('jobs')">Browse careers →</button></article><article class="card feature"><b>▦</b><h3>Keep the connection</h3><p>Meet up, learn from each other, and stay connected through alumni events.</p><button class="link" onclick="go('events')">See events →</button></article></div></section>`}
function search(p){return `<div class="search">⌕<input autofocus placeholder="${p}" value="${q}" oninput="q=this.value;render()"></div>`}function directory(){let list=alumni.filter(x=>x.join(' ').toLowerCase().includes(q.toLowerCase()));return `<section class="title"><span class="eyebrow">YOUR PEOPLE, YOUR NETWORK</span><h1>Alumni directory</h1><p>Find the people, experience, and inspiration you need for your next step.</p></section>${search('Search by name, department, company, or skill…')}<p class="eyebrow">${list.length} VERIFIED PROFILES</p><div class="grid">${list.map(x=>`<article class="card"><div class="person-head"><div class="mini">${initials(x[0])}</div><span class="verified">✓ Verified</span></div><h3>${x[0]}</h3><p style="color:#4b8494">${x[1]} · ${x[2]}</p><p>${x[3]} · Class of ${x[4]}<br>⌖ ${x[5]}</p><div class="skills">${x[6].split(', ').map(s=>`<span>${s}</span>`).join('')}</div></article>`).join('')||'<p>No alumni profiles match your search.</p>'}</div>`}
function careers(){let list=jobs.filter(x=>x.join(' ').toLowerCase().includes(q.toLowerCase()));return `<section class="title"><span class="eyebrow">CAREERS & OPPORTUNITIES</span><h1>Make your next move.</h1><p>Explore roles and internships shared by the alumni community.</p></section>${search('Search title, company, or location…')}<div class="jobs">${list.map(x=>`<article class="card job"><div class="logo">${x[1][0]}</div><div><div class="job-head"><h3>${x[0]}</h3><span class="pill">${x[2]}</span></div><p style="color:#4b8494">${x[1]} · ${x[3]}</p><p>${x[4]}</p><button class="link" onclick="${user?"flash('Application link would open here.')":"go('auth')"}">${user?'View opportunity ↗':'Sign in to view opportunity →'}</button></div></article>`).join('')}</div>`}
function eventPage(){return `<section class="title"><span class="eyebrow">STAY CONNECTED</span><h1>Community events</h1><p>Meet, learn, and celebrate with the alumni community.</p></section><div class="grid">${events.map(x=>`<article class="card"><div class="event-date">${x[0]}</div><h3>${x[1]}</h3><p>${x[3]}</p><p>⌖ ${x[2]}</p><button class="link" onclick="flash('Event interest has been recorded.')">I’m interested →</button></article>`).join('')}</div>`}
function auth(){return `<section class="card form"><span class="eyebrow">WELCOME TO ALUMNI CONNECT</span><h2>Join your community.</h2><p>Create a local demo account to explore the portal.</p><form onsubmit="login(event)"><label>Full name<input required name="name" placeholder="e.g. Alex Morgan"></label><label>Email address<input required type="email" name="email" placeholder="you@example.com"></label><label>Account type<select name="role"><option>Alumni</option><option>Student</option></select></label><button class="btn primary" style="width:100%;margin-top:8px">Create account / sign in</button></form></section>`}function login(e){e.preventDefault();let d=new FormData(e.target);user={name:d.get('name'),email:d.get('email'),role:d.get('role')};localStorage.setItem('alumni_connect_user',JSON.stringify(user));flash('Welcome to AlumniConnect!');go('dashboard')}function logout(){localStorage.removeItem('alumni_connect_user');user=null;flash('You have been logged out.');go('home')}
function dashboard(){return `<section class="title"><span class="eyebrow">YOUR DASHBOARD</span><h1>Welcome, ${user.name.split(' ')[0]}.</h1></section><section class="dashboard"><div class="card"><h2>Your profile</h2><p>Update your profile so fellow alumni and students can find you.</p><form onsubmit="save(event)"><label>Professional headline<input placeholder="e.g. Product Designer at Northstar"></label><label>Location<input placeholder="Your city"></label><label>Skills<textarea rows="3" placeholder="e.g. Design, React, Mentorship"></textarea></label><button class="btn primary">Save profile</button></form></div><aside class="card"><span class="eyebrow">QUICK LINKS</span><h3>Keep exploring</h3><p><button class="link" onclick="go('directory')">Browse the directory →</button></p><p><button class="link" onclick="go('jobs')">Explore careers →</button></p><p><button class="link" onclick="go('events')">See upcoming events →</button></p></aside></section>`}function save(e){e.preventDefault();flash('Your profile has been saved in this browser.')}function render(){q='';header();$('#app').innerHTML=({home,directory,jobs:careers,events:eventPage,auth,dashboard}[page]||home)()}render();
</script></body></html>
