<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlumniConnect | Alumni Management Portal</title>
  <style>
    :root { --navy:#12263f; --blue:#2166d1; --sky:#eaf2ff; --gold:#f2b544; --ink:#172033; --muted:#64748b; --line:#dce4ee; --white:#fff; }
    * { box-sizing:border-box; } body { margin:0; color:var(--ink); font:16px/1.55 Arial,sans-serif; background:#f7f9fc; }
    header { color:white; background:linear-gradient(120deg,var(--navy),#1b4f91); padding:0 7%; }
    nav { height:74px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .brand { font-size:1.28rem; font-weight:800; letter-spacing:.2px; } .brand span { color:var(--gold); }
    .nav-links { display:flex; align-items:center; gap:22px; } a { color:inherit; text-decoration:none; cursor:pointer; }
    .nav-links a { font-weight:600; font-size:.94rem; } .nav-links a:hover { color:#cce0ff; }
    .button { border:0; border-radius:8px; padding:11px 18px; cursor:pointer; font-weight:700; font-size:.94rem; background:var(--blue); color:white; }
    .button:hover { filter:brightness(1.08); } .button.light { background:white; color:var(--blue); } .button.outline { border:1px solid var(--blue); background:transparent; color:var(--blue); }
    .hero { min-height:420px; max-width:1160px; margin:auto; display:grid; grid-template-columns:1.2fr .8fr; align-items:center; gap:40px; }
    .hero h1 { margin:0 0 16px; font-size:clamp(2.2rem,5vw,4.1rem); line-height:1.08; } .hero p { color:#d9e8ff; max-width:600px; font-size:1.1rem; }
    .hero-actions { display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; } .hero-card { background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.25); border-radius:18px; padding:30px; backdrop-filter:blur(8px); }
    .hero-card b { font-size:2.25rem; display:block; color:var(--gold); } .hero-card p { margin:0 0 20px; font-size:.94rem; }
    main { max-width:1160px; margin:0 auto; padding:68px 24px; } section { margin-bottom:76px; } .eyebrow { color:var(--blue); font-size:.82rem; font-weight:800; text-transform:uppercase; letter-spacing:1px; }
    h2 { font-size:2rem; margin:7px 0 10px; } .lead { color:var(--muted); max-width:680px; margin:0 0 26px; }
    .stats, .grid { display:grid; gap:18px; } .stats { grid-template-columns:repeat(4,1fr); } .grid { grid-template-columns:repeat(3,1fr); }
    .stat, .card { background:white; border:1px solid var(--line); border-radius:13px; padding:22px; box-shadow:0 5px 18px rgba(15,23,42,.04); }
    .stat strong { display:block; color:var(--blue); font-size:1.9rem; } .stat span, .card p { color:var(--muted); font-size:.92rem; }
    .card h3 { margin:0 0 6px; font-size:1.1rem; } .avatar { width:45px; height:45px; display:grid; place-items:center; border-radius:50%; background:var(--sky); color:var(--blue); font-weight:800; margin-bottom:13px; }
    .tag { display:inline-block; color:#1554a6; background:var(--sky); border-radius:20px; padding:4px 10px; font-size:.78rem; font-weight:700; margin-top:9px; }
    .directory-top { display:flex; justify-content:space-between; gap:16px; align-items:end; margin-bottom:20px; } input { width:min(360px,100%); border:1px solid var(--line); padding:12px 14px; border-radius:8px; font:inherit; }
    .event { border-left:4px solid var(--gold); } .event time { color:var(--blue); font-weight:800; font-size:.86rem; }
    .cta { background:var(--navy); color:white; padding:38px; border-radius:17px; display:flex; align-items:center; justify-content:space-between; gap:24px; } .cta h2 { margin:0; } .cta p { color:#cbd9ec; margin:7px 0 0; }
    footer { background:#0d1b2a; color:#b9c5d3; padding:30px 7%; display:flex; justify-content:space-between; gap:20px; font-size:.9rem; }
    .modal { position:fixed; inset:0; z-index:4; display:none; place-items:center; background:rgba(10,25,45,.65); padding:20px; } .modal.show { display:grid; }
    .modal-box { position:relative; width:min(450px,100%); background:white; padding:28px; border-radius:14px; } .close { position:absolute; top:12px; right:15px; border:0; background:none; font-size:1.5rem; cursor:pointer; }
    label { display:block; font-size:.88rem; font-weight:700; margin:14px 0 5px; } .modal input { width:100%; } .notice { min-height:20px; color:#16803b; font-size:.88rem; margin-top:12px; }
    @media(max-width:760px) { .nav-links { display:none; } .hero { grid-template-columns:1fr; padding:55px 0; } .hero-card { display:none; } .stats,.grid { grid-template-columns:1fr; } .directory-top,.cta,footer { align-items:start; flex-direction:column; } main { padding:48px 18px; } }
  </style>
</head>
<body>
  <header>
    <nav><a class="brand" href="#home">Alumni<span>Connect</span></a><div class="nav-links"><a href="#directory">Directory</a><a href="#jobs">Careers</a><a href="#events">Events</a><button class="button light" onclick="openModal()">Join Community</button></div></nav>
    <div class="hero" id="home"><div><div class="eyebrow" style="color:#f2b544">Building lifelong connections</div><h1>Your alumni network, always within reach.</h1><p>Connect with graduates, discover career opportunities, and celebrate the achievements of your community.</p><div class="hero-actions"><a class="button light" href="#directory">Explore Alumni</a><a class="button" href="#events">Upcoming Events</a></div></div><div class="hero-card"><b>2,500+</b><p>alumni around the world</p><b>180+</b><p>new career opportunities this year</p><b>35</b><p>community events planned</p></div></div>
  </header>
  <main>
    <section><div class="eyebrow">Our impact</div><h2>A stronger community, together</h2><p class="lead">AlumniConnect brings former students, current learners, and institutions into one meaningful network.</p><div class="stats"><div class="stat"><strong>2,500+</strong><span>Registered alumni</span></div><div class="stat"><strong>42</strong><span>Countries represented</span></div><div class="stat"><strong>180+</strong><span>Career opportunities</span></div><div class="stat"><strong>35</strong><span>Events this year</span></div></div></section>
    <section id="directory"><div class="directory-top"><div><div class="eyebrow">Alumni directory</div><h2>Meet the community</h2><p class="lead">Search graduates by name, profession, or location.</p></div><input id="search" oninput="filterAlumni()" placeholder="Search alumni..." aria-label="Search alumni" /></div><div class="grid" id="alumni-grid"></div></section>
    <section id="jobs"><div class="eyebrow">Career opportunities</div><h2>Find your next opportunity</h2><p class="lead">Opportunities shared by alumni and partner organizations.</p><div class="grid" id="jobs-grid"></div></section>
    <section id="events"><div class="eyebrow">Community calendar</div><h2>Upcoming events</h2><p class="lead">Learn, reconnect, and grow with fellow alumni.</p><div class="grid" id="events-grid"></div></section>
    <section><div class="cta"><div><h2>Ready to reconnect?</h2><p>Create your alumni profile and be part of the conversation.</p></div><button class="button light" onclick="openModal()">Create Profile</button></div></section>
  </main>
  <footer><span><b>AlumniConnect</b> · Alumni Management Portal</span><span>© <span id="year"></span> All rights reserved.</span></footer>
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Join community"><div class="modal-box"><button class="close" onclick="closeModal()" aria-label="Close">×</button><h2>Join AlumniConnect</h2><p class="lead">Create a profile to connect with the community.</p><form onsubmit="register(event)"><label for="name">Full name</label><input id="name" required placeholder="Your name" /><label for="email">Email address</label><input id="email" required type="email" placeholder="you@example.com" /><label for="role">I am a</label><input id="role" required placeholder="Alumnus, student, or staff member" /><button class="button" style="margin-top:18px;width:100%">Create Profile</button><div class="notice" id="notice"></div></form></div></div>
  <script>
    const alumni=[['AS','Ananya Shah','Product Designer','Bengaluru, India'],['RM','Rohan Mehta','Software Engineer','Pune, India'],['NP','Neha Patel','Marketing Manager','Mumbai, India'],['AK','Arjun Kumar','Data Analyst','Delhi, India'],['SP','Sara Paul','UX Researcher','Kochi, India'],['VR','Vikram Rao','Founder, GreenGrid','Hyderabad, India']];
    const jobs=[['Software Engineer','BlueOrbit Technologies','Bengaluru · Full-time'],['Business Analyst','Peak Consulting','Mumbai · Hybrid'],['Product Design Intern','Paperplane Studio','Remote · Internship']];
    const events=[['28 OCT 2026','Alumni Networking Evening','Meet fellow graduates, exchange ideas, and expand your professional circle.'],['05 NOV 2026','Career Mentorship Workshop','A practical session for students and early-career professionals.'],['19 NOV 2026','Founders & Innovators Forum','Hear from alumni entrepreneurs building impactful ventures.']];
    function render(){document.getElementById('alumni-grid').innerHTML=alumni.map(a=>`<article class="card alum"><div class="avatar">${a[0]}</div><h3>${a[1]}</h3><p>${a[2]}<br>${a[3]}</p><span class="tag">View profile</span></article>`).join('');document.getElementById('jobs-grid').innerHTML=jobs.map(j=>`<article class="card"><div class="tag">Open position</div><h3 style="margin-top:14px">${j[0]}</h3><p><b>${j[1]}</b><br>${j[2]}</p><button class="button outline" onclick="alert('Application details would open here.')">View opportunity</button></article>`).join('');document.getElementById('events-grid').innerHTML=events.map(e=>`<article class="card event"><time>${e[0]}</time><h3 style="margin-top:12px">${e[1]}</h3><p>${e[2]}</p><a style="color:var(--blue);font-weight:700">Learn more →</a></article>`).join('');}
    function filterAlumni(){const q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('.alum').forEach((el,i)=>el.style.display=alumni[i].join(' ').toLowerCase().includes(q)?'block':'none');}
    function openModal(){document.getElementById('modal').classList.add('show');} function closeModal(){document.getElementById('modal').classList.remove('show');}
    function register(e){e.preventDefault();const name=document.getElementById('name').value;localStorage.setItem('alumniProfile',name);document.getElementById('notice').textContent=`Welcome, ${name}! Your demo profile has been created.`;e.target.reset();}
    document.getElementById('year').textContent=new Date().getFullYear();render();
  </script>
</body>
</html>
