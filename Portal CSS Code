:root{--navy:#173d53;--blue:#4b8ea1;--green:#4d9076;--ink:#283e4a;--muted:#71818b;--line:#e1eaec;--bg:#fbfcfc}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.topbar{background:#fff;border-bottom:1px solid var(--line);min-height:74px;padding:0 max(5%,calc((100% - 1160px)/2));display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{border:0;background:none;color:var(--navy);font-size:19px;font-weight:800;display:flex;align-items:center;gap:3px}.brand-mark{background:var(--navy);color:white;border-radius:10px;width:35px;height:35px;display:grid;place-items:center;font-size:11px;margin-right:7px}.brand>span:last-child{font-weight:400;color:#74929e}.nav{height:74px;display:flex;gap:20px}.nav button{border:0;border-bottom:3px solid transparent;background:none;color:#687982;font-size:13px;font-weight:bold}.nav button.active{border-bottom-color:var(--blue);color:var(--navy)}.container{max-width:1160px;margin:auto;padding:55px 0;min-height:calc(100vh - 145px)}.btn{padding:10px 15px;border:1px solid transparent;border-radius:7px;font-size:13px;font-weight:bold}.primary{background:var(--navy);color:#fff}.secondary{background:#fff;color:var(--navy);border-color:#cad9de}.small{padding:8px 11px;font-size:12px}.hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:410px;align-items:center;gap:30px}.eyebrow{color:#4a8999;letter-spacing:1.6px;font-size:10px;font-weight:bold}.hero h1,.title h1,h2,h3{color:var(--navy);letter-spacing:-1px;line-height:1.15}.hero h1{font-size:57px;margin:16px 0}.hero h1 span{color:var(--blue)}.lead,.title p,.card p{color:var(--muted)}.lead{max-width:510px;line-height:1.8}.row{display:flex;gap:10px;flex-wrap:wrap}.art{height:330px;display:grid;place-items:center;position:relative}.orbit{position:absolute;width:350px;height:255px;border:1px solid #dce8e8;border-radius:50%;transform:rotate(-25deg)}.spotlight{z-index:1;width:270px;background:#fff;border:1px solid var(--line);border-radius:15px;text-align:center;padding:22px;box-shadow:0 20px 50px #17384c17}.avatar{width:74px;height:74px;margin:15px auto;border-radius:50%;background:#dcece8;color:#35666b;display:grid;place-items:center;font-size:22px;font-weight:bold}.tag,.pill{display:inline-block;background:#edf5f3;color:#507a74;padding:5px 8px;border-radius:4px;font-size:10px;font-weight:bold}.note{position:absolute;background:#fff;border:1px solid var(--line);border-radius:9px;padding:10px 13px;box-shadow:0 10px 25px #183b5620;font-size:11px}.note.a{top:40px;right:0}.note.b{bottom:35px;left:0}.stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);padding:23px}.stat{text-align:center;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat b{display:block;color:var(--navy);font-size:25px}.stat span{font-size:11px;color:var(--muted)}.section{padding-top:63px}.head{display:flex;align-items:end;justify-content:space-between;margin-bottom:23px}.head h2{font-size:30px;margin:9px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:11px;padding:20px}.feature{min-height:200px}.feature:nth-child(1){background:#edf5f7}.feature:nth-child(2){background:#fbf6e7}.feature:nth-child(3){background:#edf6f0}.feature h3{margin:12px 0 7px}.link{color:#397d91;border:0;background:none;font-weight:bold;padding:0}.title{margin-bottom:22px}.title h1{font-size:42px;margin:9px 0}.search{max-width:680px;border:1px solid #dce7ea;border-radius:8px;background:#fff;padding:0 13px;display:flex;align-items:center;margin:20px 0}.search input{padding:13px;border:0;outline:0;flex:1;background:transparent}.person-head,.job-head{display:flex;justify-content:space-between;align-items:start;gap:10px}.mini{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:#e2eef0;color:#376d7d;font-weight:bold}.verified{font-size:10px;background:#e9f6ee;color:#438264;padding:5px 7px;border-radius:20px}.skills{display:flex;gap:5px;flex-wrap:wrap;margin-top:13px}.skills span{font-size:10px;background:#f0f5f6;color:#5e7c85;padding:5px 7px;border-radius:4px}.jobs{display:grid;gap:12px}.job{display:flex;gap:15px}.logo{width:45px;height:45px;flex:0 0 45px;display:grid;place-items:center;background:#e6f0f3;color:#397c8e;font-weight:bold;border-radius:10px}.event-date{font-size:11px;color:#45866e;font-weight:bold}.notice{padding:12px 15px;border-radius:7px;background:#eaf6ef;color:#2d7354;margin-bottom:20px;font-size:13px}.hidden{display:none}.form{max-width:440px;margin:auto}.form label{display:grid;gap:6px;margin:13px 0;color:#536874;font-size:12px;font-weight:bold}.form input,.form select,.form textarea{border:1px solid #dce5e8;border-radius:6px;padding:10px}.dashboard{display:grid;grid-template-columns:1.6fr .8fr;gap:20px}footer{border-top:1px solid var(--line);padding:24px;text-align:center;font-size:11px;color:#849199}@media(max-width:800px){.topbar{padding:12px 5%;flex-wrap:wrap}.nav{order:3;width:100%;height:34px;overflow:auto}.container{padding:40px 5%}.hero{grid-template-columns:1fr}.hero h1{font-size:44px}.art{height:285px}.grid,.dashboard{grid-template-columns:1fr}.note.a{right:0}.note.b{left:0}.stats{padding:18px 0}.stat b{font-size:20px}}
